/* Textual CSS (TCSS) — a subset of CSS for terminal layout.
   Selectors match widget class names: InstanceHeader targets the InstanceHeader widget.
   See https://textual.textualize.io/css_reference/ */

InstanceHeader {
    dock: top;      /* Pin to top edge of parent, removed from normal flow */
    height: auto;
    padding: 1 2;
    background: $panel;
    border-bottom: wide $accent 40%;
}

#main-container {
    height: 1fr;
}

#left-panel {
    width: 2fr;
    min-width: 36;
    max-width: 72;
}

#phases-section {
    height: auto;
    min-height: 3;
    max-height: 50%;
    border-title-align: right;
}

#tabs-section {
    height: 1fr;
}

#lower-left-tabs {
    height: 1fr;
}

#lower-left-tabs TabPane {
    overflow-y: auto;
}

OperationsPanel, PhaseDetail {
    height: auto;
}

#warnings-section {
    height: auto;
    max-height: 10;
    overflow-y: auto;
    border-title-align: right;
}

WarningsPanel {
    height: auto;
}

#right-panel {
    width: 3fr;
}

#output-section {
    height: 1fr;
    border-title-align: right;
    border-subtitle-align: right;
}

PhaseTree {
    height: auto;
    background: transparent;
    padding: 0;
}

PhaseDetail {
    height: auto;
}

OutputPanel {
    width: 1fr;
}
